# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Postgres in production; omit to use local SQLite (development only)
DATABASE_URL=postgres://tracker:tracker@db:5432/tracker
# Set true when served behind HTTPS
DJANGO_SECURE_SSL=false
# Email (invites + password reset). Omit EMAIL_HOST to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=intern-tracker@example.edu
